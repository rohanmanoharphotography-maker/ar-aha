  "sources": [
    {
      "claim": "Most refrigerated vaccines are stored between 2°C and 8°C (36°F–46°F).",
      "source": "CDC, Vaccine Storage and Handling Toolkit",
      "url": "https://www.cdc.gov/vaccines/hcp/storage-handling/"
    },
    {
      "claim": "Heat exposure reduces vaccine potency; exposure to freezing temperatures can permanently damage many refrigerated vaccines, and loss of potency cannot be seen.",
      "source": "CDC, Vaccine Storage and Handling Toolkit; WHO, Immunization in Practice (Module 3: The cold chain)",
      "url": "https://www.cdc.gov/vaccines/hcp/storage-handling/"
    },
    {
      "claim": "The cold chain spans manufacturer, distribution and the provider, using refrigerated transport and qualified insulated containers with conditioned cold packs.",
      "source": "CDC, Vaccine Storage and Handling Toolkit (Transport section); WHO Immunization in Practice",
      "url": "https://www.cdc.gov/vaccines/hcp/storage-handling/"
    },
    {
      "claim": "Digital data loggers continuously record storage temperatures.",
      "source": "CDC, Vaccine Storage and Handling Toolkit (Temperature Monitoring Equipment)",
      "url": "https://www.cdc.gov/vaccines/hcp/storage-handling/"
    },
    {
      "claim": "Vaccine vial monitors are heat-sensitive labels; if the inner square matches or is darker than the outer circle, the vaccine should not be used.",
      "source": "WHO, Vaccine Vial Monitor guidance",
      "url": "https://www.who.int/teams/immunization-vaccines-and-biologicals/essential-programme-on-immunization/supply-chain"
    },
    {
      "claim": "Use purpose-built/dedicated vaccine storage units and check and record temperatures at the start of each workday.",
      "source": "CDC, Vaccine Storage and Handling Toolkit",
      "url": "https://www.cdc.gov/vaccines/hcp/storage-handling/"
    },
    {
      "claim": "After a temperature excursion, label vaccines 'Do Not Use', keep them stored at proper temperature, and contact the manufacturer or immunization program before using or discarding.",
      "source": "CDC, Vaccine Storage and Handling Toolkit (Temperature Excursions)",
      "url": "https://www.cdc.gov/vaccines/hcp/storage-handling/"
    }
  ]
