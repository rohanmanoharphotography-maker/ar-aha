# All variables are optional. The pipeline runs fully offline with local models.

# Enables `--topic` for topics without a storyboard pack in input/ (Claude writes the script + storyboard).
ANTHROPIC_API_KEY=

# Use a specific Chromium/headless-shell binary for rendering (auto-detected under PLAYWRIGHT_BROWSERS_PATH).
REMOTION_BROWSER_EXECUTABLE=

# Parallel frames during render (default 4).
REMOTION_CONCURRENCY=4
